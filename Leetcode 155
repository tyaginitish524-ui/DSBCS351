#include <stdlib.h>

#define INITIAL_CAPACITY 1024

typedef struct {
    int *data;
    int *min_data;
    int top_idx;
    int capacity;
} MinStack;

MinStack* minStackCreate() {
    MinStack* obj = (MinStack*)malloc(sizeof(MinStack));
    obj->capacity = INITIAL_CAPACITY;
    obj->top_idx = -1;
    obj->data = (int*)malloc(sizeof(int) * obj->capacity);
    obj->min_data = (int*)malloc(sizeof(int) * obj->capacity);
    return obj;
}

void minStackPush(MinStack* obj, int val) {
    if (obj->top_idx + 1 == obj->capacity) {
        obj->capacity *= 2;
        obj->data = (int*)realloc(obj->data, sizeof(int) * obj->capacity);
        obj->min_data = (int*)realloc(obj->min_data, sizeof(int) * obj->capacity);
    }
    
    obj->top_idx++;
    obj->data[obj->top_idx] = val;
    
    if (obj->top_idx == 0) {
        obj->min_data[obj->top_idx] = val;
    } else {
        int current_min = obj->min_data[obj->top_idx - 1];
        obj->min_data[obj->top_idx] = (val < current_min) ? val : current_min;
    }
}

void minStackPop(MinStack* obj) {
    if (obj->top_idx >= 0) {
        obj->top_idx--;
    }
}

int minStackTop(MinStack* obj) {
    return obj->data[obj->top_idx];
}

int minStackGetMin(MinStack* obj) {
    return obj->min_data[obj->top_idx];
}

void minStackFree(MinStack* obj) {
    free(obj->data);
    free(obj->min_data);
    free(obj);
}
