#include <stdbool.h>
#include <stdlib.h>
#include <string.h>

bool isValid(char* s) {
    int len = strlen(s);
    
    // An odd-length string cannot be valid
    if (len % 2 != 0) {
        return false;
    }
    
    // Allocate stack memory bounded by string length
    char* stack = (char*)malloc(len * sizeof(char));
    int top = -1;
    
    for (int i = 0; i < len; i++) {
        char c = s[i];
        
        // Push opening brackets onto the stack
        if (c == '(' || c == '{' || c == '[') {
            stack[++top] = c;
        } else {
            // Found a closing bracket with no matching opening bracket
            if (top == -1) {
                free(stack);
                return false;
            }
            
            char topChar = stack[top--];
            
            // Verify matching pairs
            if ((c == ')' && topChar != '(') ||
                (c == '}' && topChar != '{') ||
                (c == ']' && topChar != '[')) {
                free(stack);
                return false;
            }
        }
    }
    
    // If the stack is empty, all brackets matched correctly
    bool valid = (top == -1);
    free(stack);
    return valid;
}
