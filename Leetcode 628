#include <limits.h>

int maximumProduct(int* nums, int numsSize) {
    // 3 largest elements
    int max1 = INT_MIN; // largest
    int max2 = INT_MIN; // 2nd largest
    int max3 = INT_MIN; // 3rd largest
    
    // 2 smallest elements
    int min1 = INT_MAX; // smallest
    int min2 = INT_MAX; // 2nd smallest

    for (int i = 0; i < numsSize; i++) {
        int val = nums[i];

        // Track the 3 largest numbers
        if (val > max1) {
            max3 = max2;
            max2 = max1;
            max1 = val;
        } else if (val > max2) {
            max3 = max2;
            max2 = val;
        } else if (val > max3) {
            max3 = val;
        }

        // Track the 2 smallest numbers
        if (val < min1) {
            min2 = min1;
            min1 = val;
        } else if (val < min2) {
            min2 = val;
        }
    }

    int prod1 = max1 * max2 * max3;
    int prod2 = min1 * min2 * max1;

    return (prod1 > prod2) ? prod1 : prod2;
}
